# Cloudflare R2 Configuration
# You can get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Public domain for accessing uploaded images (custom domain or pub-xxx.r2.dev)
# Example: https://img.yourdomain.com or https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_DOMAIN=https://your_public_domain_or_r2_pub_url
